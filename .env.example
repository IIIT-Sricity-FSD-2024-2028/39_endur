# Every variable the API needs. Copy to .env and fill the blanks.
# lib/config.ts parses this with Zod at boot — a missing required value kills the
# process on startup, not with a confusing 500 during the demo (14 §5).

NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://endur:endur@localhost:5432/endur

# Where `npm test` writes. NEVER the same as DATABASE_URL: the suite registers orgs and
# truncates, and pointed at the development database it deletes the demo seed — which is
# how the advertised logins stopped working on 19 Aug (D-004). Optional: absent, it is
# derived by appending `_test` to the name above. The database is created and migrated
# automatically on the first run. The name must end in `_test` or the suite refuses to start.
TEST_DATABASE_URL=postgresql://endur:endur@localhost:5432/endur_test

SESSION_SECRET=             # >=32 chars. required. DEC-014 — staff auth is a cookie session.
SESSION_TTL_DAYS=7          # rolling: active use extends it
COOKIE_SECURE=false         # true everywhere except local dev

API_KEY_SECRET=             # >=32 chars. signs integration keys only (45, P3)

# The single most demo-critical variable. If this says localhost, the QR code does
# not scan from a phone. See _MEMORY.md OPEN-002.
PUBLIC_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:4000

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

K_ANON_THRESHOLD=5          # results hidden below this many responses (52)
LOG_LEVEL=info

# Logs on disk (18). Two rotating files: logs/app-<date>.log and logs/error-<date>.log,
# both alongside stdout, never instead of it.
LOG_DIR=                    # default src/backend/logs, resolved from the api package
LOG_TO_FILE=                # default true, except under NODE_ENV=test
LOG_RETENTION_DAYS=14       # files older than this are removed at the day rotation
LOG_MAX_SIZE_MB=10          # rotates within the day at this size: app-<date>.1.log

# Uploaded binaries (48). Tenant-partitioned: <dir>/<orgId>/<fileId>.<ext>
STORAGE_DIR=                # default src/backend/storage, resolved from the api package
UPLOAD_MAX_MB=2             # rejected DURING streaming, never after buffering
