/// Staff. **Respondents are NOT users** (DEC-009) — that is a privacy decision first and a
/// billing one second: a college with 4,000 respondents has perhaps 200 rows here.
model User {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId  String @map("org_id") @db.Uuid
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /// Case-insensitive: nobody should fail to sign in over a capital letter.
  email        String  @db.Citext
  /// NULL for invited-not-yet-activated.
  passwordHash String? @map("password_hash")
  name         String
  /// active | invited | disabled
  status       String  @default("active")

  avatarFileId String? @map("avatar_file_id") @db.Uuid
  avatar       File?   @relation("UserAvatar", fields: [avatarFileId], references: [id], onDelete: SetNull)

  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  personNodes      Node[]
  grantsCreated    Grant[]     @relation("GrantCreatedBy")
  subjectsLinked   Subject[]   @relation("SubjectLinkedUser")
  campaignsCreated Campaign[]  @relation("CampaignCreatedBy")
  filesUploaded    File[]      @relation("FileCreatedBy")
  auditEntries     AuditLog[]

  @@unique([orgId, email])
  @@map("users")
}

// ---------------------------------------------------------------------------
// The org graph — three primitives, and the whole generality of the product
// ---------------------------------------------------------------------------

model Node {
  id    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId String @map("org_id") @db.Uuid
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  kind NodeKind
  name String

  /// Roles only. 1 = highest. **Ordering only, nothing else** — the level rule is a
  /// seeded default (§2.4, CONF-002), never the enforcement mechanism.
  level Int?

  roleId String? @map("role_id") @db.Uuid
  role   Node?   @relation("PositionRole", fields: [roleId], references: [id], onDelete: Cascade)
  unitId String? @map("unit_id") @db.Uuid
  unit   Node?   @relation("PositionUnit", fields: [unitId], references: [id], onDelete: Cascade)

  userId String? @map("user_id") @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Units: children get end dates, so nobody has to remember to revoke anything (§9).
  isTemporary Boolean   @default(false) @map("is_temporary")
  endsAt      DateTime? @map("ends_at") @db.Timestamptz(6)

  /// Generated from a placement rule. ~10 declared answers produce ~200 stored rows,
  /// and that ratio is why setup takes minutes rather than days.
  derived Boolean @default(false)
  meta    Json    @default("{}")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  positionsWithRole Node[] @relation("PositionRole")
  positionsInUnit   Node[] @relation("PositionUnit")

  edgesAsParent Edge[]    @relation("EdgeParent")
  edgesAsChild  Edge[]    @relation("EdgeChild")
  grants        Grant[]   @relation("GrantSubject")
  subjectsInUnit Subject[] @relation("SubjectUnit")

  @@index([orgId, kind])
  @@map("nodes")
}

/// **There is never one global tree.** Each dimension is its own tree; within a dimension a
/// node has one parent, across dimensions it may have many. That is what lets a head of
/// department report to the dean academically and the registrar administratively.
model Edge {
  id    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId String @map("org_id") @db.Uuid
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /// 'academic', 'reporting', 'project', …
  dimension String   @default("primary")
  type      EdgeType

  parentId String @map("parent_id") @db.Uuid
  parent   Node   @relation("EdgeParent", fields: [parentId], references: [id], onDelete: Cascade)
  childId  String @map("child_id") @db.Uuid
  child    Node   @relation("EdgeChild", fields: [childId], references: [id], onDelete: Cascade)

  /// For a person's main position.
  isPrimary Boolean   @default(false) @map("is_primary")
  validFrom DateTime  @default(now()) @map("valid_from") @db.Timestamptz(6)
  /// NULL = open ended. History is retained, so access expires without the row vanishing.
  validTo   DateTime? @map("valid_to") @db.Timestamptz(6)
  derived   Boolean   @default(false)
  /// Delegation recurrence lives here.
  meta      Json      @default("{}")

  @@unique([orgId, dimension, type, parentId, childId])
  @@index([orgId, dimension, type])
  @@map("edges")
}

/// Resolution semantics — deny-beats-allow (INV-004), narrower-scope-wins — are specified
/// in 11 §5. They are NOT re-stated here: this table only stores.
model Grant {
  id    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId String @map("org_id") @db.Uuid
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /// A role, position, group or person node. Role grants are the common case.
  subjectId String @map("subject_id") @db.Uuid
  subject   Node   @relation("GrantSubject", fields: [subjectId], references: [id], onDelete: Cascade)

  /// From the catalogue in packages/shared/src/capabilities.ts (11 §3).
  capability String
  scope      GrantScope  @default(own_unit)
  effect     GrantEffect @default(allow)
  /// { "maxAmount": 25000 } — one capability at different strengths, instead of
  /// inventing five artificial roles to encode limits.
  params     Json        @default("{}")

  validFrom DateTime  @default(now()) @map("valid_from") @db.Timestamptz(6)
  validTo   DateTime? @map("valid_to") @db.Timestamptz(6)

  /// Editing a derived grant CLEARS this flag, so the next regeneration cannot silently
  /// revert an administrator's change (§9).
  derived Boolean @default(false)

  createdById String?  @map("created_by") @db.Uuid
  createdBy   User?    @relation("GrantCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([orgId, subjectId, capability, scope, effect])
  @@index([orgId, capability])
  @@map("grants")
}

// ---------------------------------------------------------------------------
// The feedback domain
// ---------------------------------------------------------------------------

/// The single biggest unlock in the model. A course, a restaurant, a ward, a bus route.
/// `linkedUserId` turns "review the thing" into "review the person" with no second code path.
model Subject {
  id    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId String @map("org_id") @db.Uuid
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  unitId String? @map("unit_id") @db.Uuid
  unit   Node?   @relation("SubjectUnit", fields: [unitId], references: [id], onDelete: SetNull)

  name String
  type String @default("general")

  linkedUserId String? @map("linked_user_id") @db.Uuid
  linkedUser   User?   @relation("SubjectLinkedUser", fields: [linkedUserId], references: [id], onDelete: SetNull)

  meta Json @default("{}")
  /// Archived, never hard-deleted while responses exist (§9).
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  campaigns CampaignSubject[]
  responses Response[]

  @@map("subjects")
}

model Template {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// NULL = library template, cloned into orgs on demand.
  orgId String? @map("org_id") @db.Uuid
  org   Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  name        String
  category    String
  industry    String?
  description String?

  clonedFromId String?    @map("cloned_from_id") @db.Uuid
  clonedFrom   Template?  @relation("TemplateClone", fields: [clonedFromId], references: [id], onDelete: SetNull)
  clones       Template[] @relation("TemplateClone")

  /// DERIVED from the questions, never entered by hand.
  estimatedSeconds Int       @default(0) @map("estimated_seconds")
  publishedAt      DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  questions Question[]
  campaigns Campaign[]

  @@map("templates")
}

model Question {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId String   @map("template_id") @db.Uuid
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  kind QuestionKind
  text String
  /// Shape per kind is a discriminated Zod union (14 §4) — that is what stops this
  /// column from becoming an untyped bag.
  config   Json    @default("{}")
  required Boolean @default(false)
  /// DEFERRABLE unique on (template_id, position), added in SQL: a reorder is then one
  /// UPDATE inside a transaction rather than a shuffle through a temporary value.
  position Int

  answers Answer[]

  @@map("questions")
}

