model CampaignSubject {
  campaignId String   @map("campaign_id") @db.Uuid
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  subjectId  String   @map("subject_id") @db.Uuid
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([campaignId, subjectId])
  @@map("campaign_subjects")
}

/// **There is no respondent column here, and there never will be one** (INV-006). Not a
/// user id, not a hashed email, not an IP. The table cannot identify a respondent because
/// it has nothing to identify them with — anonymity is a property of the schema, not a
/// setting the application respects.
model Response {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId String   @map("campaign_id") @db.Uuid
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  subjectId String?  @map("subject_id") @db.Uuid
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  submittedAt DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)
  /// link | qr | kiosk | api
  channel     String   @default("link")
  durationMs  Int?     @map("duration_ms")
  /// NEVER identity.
  meta        Json     @default("{}")

  answers Answer[]

  @@index([campaignId, submittedAt(sort: Desc)])
  @@map("responses")
}

model Answer {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  responseId String   @map("response_id") @db.Uuid
  response   Response @relation(fields: [responseId], references: [id], onDelete: Cascade)
  questionId String   @map("question_id") @db.Uuid
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  /// Typed by question kind (14 §4).
  value Json
  /// Denormalised for rating/NPS aggregation. Written by the service layer alongside
  /// `value`, never independently — `(value->>'n')::numeric` on every row is the
  /// difference between a fast results page and a slow one.
  numericValue Decimal? @map("numeric_value") @db.Decimal

  @@unique([responseId, questionId])
  @@map("answers")
}

/// Records **that** a token was used. `responses` records **what** was said. Nothing joins
/// them — so the system can report "312 of 400 responded" and still not know whose is whose.
/// This separation is the entire privacy architecture.
model Invitation {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId String   @map("campaign_id") @db.Uuid
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  token  String    @unique
  usedAt DateTime? @map("used_at") @db.Timestamptz(6)
  meta   Json      @default("{}")

  @@map("invitations")
}

// ---------------------------------------------------------------------------
// Cross-cutting
// ---------------------------------------------------------------------------

/// Uploaded binaries: org logos and user avatars only (48). Bytes live on disk; this row
/// is the metadata and the id in the URL.
model File {
  id    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId String @map("org_id") @db.Uuid
  org   Organization @relation("FileOrganization", fields: [orgId], references: [id], onDelete: Cascade)

  /// 'logo' | 'avatar'
  kind String
  /// Always the RE-ENCODED type, never the uploaded one — re-encoding is what strips
  /// metadata such as EXIF GPS (48, INV-006).
  mime   String
  bytes  Int
  width  Int?
  height Int?

  createdById String?  @map("created_by") @db.Uuid
  createdBy   User?    @relation("FileCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organizationLogos Organization[] @relation("OrganizationLogo")
  userAvatars       User[]         @relation("UserAvatar")

  @@index([orgId, kind])
  @@map("files")
}

