/// 13 §7. The first response to a keyed request, replayed for 24 h. The respondent submit
/// is the case that matters: a phone on a flaky venue network retries, and a duplicate
/// response corrupts the demo's numbers in front of the evaluator.
model IdempotencyKey {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// NULL for respondent submits — a public caller has a campaign, not an organisation.
  orgId String?       @map("org_id") @db.Uuid
  org   Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  key      String
  endpoint String
  /// Same key, different body, is a client bug. Answering it with the cached response of a
  /// different request would be worse than an error, so the hash is compared.
  requestHash String @map("request_hash")

  status Int
  body   Json

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@map("idempotency_keys")
}

