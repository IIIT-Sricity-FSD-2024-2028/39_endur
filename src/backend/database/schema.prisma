  targetType String? @map("target_type")
  targetId   String? @map("target_id") @db.Uuid

  /// WHICH GRANT decided it (INV-007). This is what turns "access denied" from an
  /// assertion into evidence, and it is what the simulator replays (42).
  decidedBy Json?   @map("decided_by")
  requestId String? @map("request_id")
  ip        String? @db.Inet

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

